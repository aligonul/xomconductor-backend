# Slack App Credentials
# Get these from https://api.slack.com/apps/A0B456A1ZHU

# Bot User OAuth Token (OAuth & Permissions > Bot User OAuth Token)
# Requires scopes: chat:write, chat:write.public, channels:read, groups:read
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token for Socket Mode (Basic Information > App-Level Tokens)
# Requires scope: connections:write
SLACK_APP_TOKEN=xapp-your-app-token-here

# Channel ID for #ali-xommail-sf-extension
# Right-click channel > View channel details > scroll to bottom for Channel ID
ALI_SLACK_CHANNEL_ID=C0ABCD12345

# Anthropic API Key for Claude drafting
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Override Claude model (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Salesforce Credentials
# Get security token from: Setup > Personal Settings > Reset My Security Token
SF_USERNAME=your.email@company.com
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=your-security-token
# SF_DOMAIN=login  # Use 'test' for sandbox, 'login' for production
